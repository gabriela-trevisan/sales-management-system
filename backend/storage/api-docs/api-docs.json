                                        "example": "João Silva"
                                    },
                                    "document": {
                                        "type": "string",
                                        "example": "123.456.789-00"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "joao@example.com"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "example": "(11) 98765-4321",
                                        "nullable": true
