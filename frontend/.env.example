# URL relativa — o Vite proxy encaminha /api/* e /sanctum/* para VITE_BACKEND_PROXY_TARGET.
# Para desenvolvimento local (sem Docker): VITE_BACKEND_PROXY_TARGET=http://localhost:8000
# Para Docker: VITE_BACKEND_PROXY_TARGET=http://nginx:8000
VITE_API_URL=/api
VITE_BACKEND_PROXY_TARGET=http://localhost:8000
VITE_APP_NAME="Sales Management System"
VITE_APP_ENV=development
